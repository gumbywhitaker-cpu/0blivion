# Copy to ~/.hermes/.env (inside WSL2) and fill in real values.
# Never commit a filled-in version of this file anywhere.

# Hermes Agent API server (required — grants full toolset incl. terminal)
API_SERVER_ENABLED=true
API_SERVER_KEY=REPLACE_ME_run_python3_-c_"import secrets;print(secrets.token_urlsafe(32))"

# jarvis_ai HUD access token (browser-facing; asked for once per device)
JARVIS_HUD_TOKEN=REPLACE_ME_run_python3_-c_"import secrets;print('jarvis-'+secrets.token_hex(3))"

# ElevenLabs voice (free tier works; get a key at elevenlabs.io)
ELEVENLABS_API_KEY=REPLACE_ME
