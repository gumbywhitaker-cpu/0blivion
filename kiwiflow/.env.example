DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional adapter-point keys — features fail closed with a clear message
# when these are unset, rather than throwing (see lib/notify.ts, lib/aiGrading.ts).
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
# Powers the packhouse's optional AI photo grading cross-check (lib/aiGrading.ts)
# and the AI Daily Briefing (lib/dailyBriefing.ts).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_ID="claude-sonnet-5"
# lib/weather.ts (the grower dashboard's spray-window forecast) already runs on
# Open-Meteo, which needs no key. This is a second, separately-wired provider —
# see lib/openweathermap.ts — not yet called from any page.
OPENWEATHER_API_KEY=""
