DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional adapter-point keys — features fail closed with a clear message
# when these are unset, rather than throwing (see lib/notify.ts, lib/aiGrading.ts).
# EMAIL_PROVIDER_API_KEY is a Resend API key (resend.com) — URGENT/CRITICAL
# in-app notifications also send an email once this is set. EMAIL_FROM_ADDRESS
# must be on a domain verified in the Resend dashboard for real delivery
# beyond Resend's own test inbox; defaults to Resend's onboarding@resend.dev
# sandbox address if unset (only deliverable to the Resend account's own
# email while unverified).
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="KiwiFlow <onboarding@resend.dev>"
SMS_PROVIDER_API_KEY=""
# Powers the packhouse's optional AI photo grading cross-check (lib/aiGrading.ts)
# and the AI Daily Briefing (lib/dailyBriefing.ts).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_ID="claude-sonnet-5"
# lib/weather.ts (the grower dashboard's spray-window forecast) already runs on
# Open-Meteo, which needs no key. This is a second, separately-wired provider —
# see lib/openweathermap.ts — not yet called from any page.
OPENWEATHER_API_KEY=""

# Xero accounting sync (lib/xero.ts) — register a Xero Developer app at
# developer.xero.com to get these; redirect URI must match exactly what's
# registered there, e.g. https://yourdeployment.example/api/xero/callback.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI=""

# MYOB AccountRight accounting sync (lib/myob.ts) — register a MYOB
# Developer app at my.myob.com's Developer tab to get these; redirect URI
# must match exactly, e.g. https://yourdeployment.example/api/myob/callback.
MYOB_CLIENT_ID=""
MYOB_CLIENT_SECRET=""
MYOB_REDIRECT_URI=""
